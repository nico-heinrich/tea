# SvelteKit requires PUBLIC_ prefix for environment variables exposed to the client.
# These are substituted at build time via $env/static/public.
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Supabase project URL (public, safe to expose to client)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose to client — protected by RLS)
# Find this in your Supabase project dashboard: Settings > API > Project API keys > anon/public
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: base URL of the self-hosted GeoIP service used to resolve the
# country/city of missing-shop vote submissions. Defaults to
# https://ip-location.exord.xyz when unset.
PRIVATE_GEO_API_BASE=https://ip-location.exord.xyz
